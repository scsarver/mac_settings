# Template for ~/.netmode.local — copy, fill in, and keep OUT of git.
#
#   cp home/.functions/.network_functions.example ~/.netmode.local
#   chmod 600 ~/.netmode.local
#
# These override the generic defaults in .network_functions. Real addresses belong
# here, never in the committed file — this repo is public.

NETMODE_USB_DEV="en7"                  # your USB ethernet interface

NETMODE_ROUTER_TARGET="192.168.1.1"    # main router
NETMODE_SWITCH_TARGET="192.168.0.1"    # managed switch

NETMODE_C7_TARGET="192.168.0.1"        # secondary router / AP
NETMODE_C7_MASK="255.255.255.0"

# ONE PROFILE PER DIRECTLY-CABLED DEVICE. The service names must match the macOS
# network services exactly — 'netmode' only enables and disables them, it never
# rewrites their IP configuration.
#
# Do NOT point both of these at one shared profile you retype per use: a single
# slot serving two devices is wrong for one of them at all times, and its saved
# values do not record which device it was last aimed at.

NETMODE_DEV_A_SVC="Direct connect 1"   # macOS service name, device A
NETMODE_DEV_A_IP="192.168.0.219"       # this Mac's address on the A link
NETMODE_DEV_A_TARGET="192.168.0.215"   # device A itself

NETMODE_DEV_B_SVC="Direct connect 2"   # macOS service name, device B
NETMODE_DEV_B_IP="192.168.0.220"       # this Mac's address on the B link
NETMODE_DEV_B_TARGET="192.168.0.217"   # device B itself
