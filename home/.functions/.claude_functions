# =============================================================================
# ntwork - one command to get a Claude Code session into an isolated git
#          worktree instead of the repo's shared main working directory
#
# WHY THIS EXISTS:
#   Running multiple Claude Code sessions against the same repo at once is
#   normal (a laptop terminal plus a phone/cloud session, two tabs, etc.), and
#   nothing about starting a session automatically isolates it - a session's
#   working directory is fixed the instant it launches, before any project
#   instructions are even read. So two sessions with uncommitted edits can
#   collide by writing to the SAME files in the SAME directory before either
#   commits. That already happened here once (2026-08-22: a concurrent
#   session's `git reset --hard` destroyed six uncommitted edits belonging to
#   another session).
#
#   Repos that want this isolated need their own ./scripts/worktree.sh (see
#   network-topology's, added 2026-08-22/23) - a per-issue git worktree, so
#   each session gets its own working directory and branch, with an enforced
#   sync-before-merge rule so reconciliation happens on purpose, not by
#   accident mid-edit.
#
#   ntwork is the missing last step: worktree.sh still has to be run BEFORE
#   the session that will do the work starts, by whoever launches it - no
#   rule inside the repo can reach back and do that, because the working
#   directory is already fixed by the time any of the repo's own instructions
#   load. Doing it by hand is three steps (create/reuse the worktree, cd into
#   it, launch claude) easy to skip out of habit. ntwork makes it one.
#
# EXTENDED 2026-08-23: two gaps closed after a week of using this.
#   1. Finishing/syncing/listing/dropping still meant switching to
#      `./scripts/worktree.sh <verb>` by hand - one tool to start work, a
#      different one for the rest of its life. ntwork now forwards
#      list/sync/finish/drop/path/next-number straight to worktree.sh, so
#      it's the only name to remember for the whole lifecycle. It still does
#      none of the actual git work itself - worktree.sh remains the engine,
#      ntwork is just the single front door onto it.
#   2. Starting brand-new work meant digging up the next unused issue number
#      by hand first. Pass ntwork more than one space-free token (a
#      description, not a bare number/name) and it asks worktree.sh for
#      `next-number` - a read-only, advisory number only; nothing is
#      reserved until the issue is actually written up, same as always -
#      then launches claude with that description as the first message
#      instead of an empty session.
#
# EXTENDED 2026-08-23 (again): two more fixes from a week of actually using this.
#   1. REAL BUG: `ntwork 67 fix the login bug` did NOT resume issue 67 - the explicit-target
#      path only fired for EXACTLY one space-free word, so any multi-word call (even one led by
#      a bare issue number) fell into the free-text auto-number branch, discarding the "67" and
#      creating a brand-new, unrelated issue instead. This is confirmed to be how a real issue-79
#      came to exist when issue-67 was what was meant. Fixed: a bare leading number now always
#      wins as the target, with the rest of the words as claude's first message.
#   2. Forwards `next-round` too, alongside next-number - see worktree.sh's own header for the
#      naming pattern this pairs with (issue-N first, issue-N-2/-3/... for later, SEPARATE
#      worktrees on that same issue N - decided so the branch name alone says what it relates to,
#      no need to go read git log to disambiguate a reused name).
#
# WHAT THIS DELIBERATELY DOES NOT DO:
#   - Does not know anything about network-topology specifically. It works
#     against whatever repo you're standing in, as long as it has an
#     executable ./scripts/worktree.sh with start/path subcommands, and
#     list/sync/finish/drop/next-number if you want those forwarded too. No
#     site-specific values here - safe for this repo being public.
#   - Does not launch claude for you if it can't resolve a worktree path -
#     fails loudly instead of guessing.
#   - Does not decide what a "free-text description" means beyond word
#     count - a single space-free token is always treated as an explicit
#     issue number/name, exactly as before this extension.
# =============================================================================

function ntwork {
  case "${1:-}" in
    -h|--help|--usage)
      echo "usage: ntwork <issue-number-or-name>              launch claude in that worktree"
      echo "       ntwork <issue-number> <first message...>  open/resume THAT issue's worktree,"
      echo "                                                  claude's first message is the rest"
      echo "       ntwork <a free-text description, no leading number>   auto-number NEW work,"
      echo "                                                  claude's first message is all of it"
      echo "       ntwork list|sync|finish|drop|path|next-number|next-round [name]   forwarded to ./scripts/worktree.sh"
      echo "       ntwork -h|--help|--usage              show this"
      echo "  (run from inside a repo with an executable ./scripts/worktree.sh)"
      # Pulled live from the target repo's own script, not copied here, so this can't drift out
      # of sync with what worktree.sh actually does - see the file header for why that matters.
      if [ -x ./scripts/worktree.sh ]; then
        echo
        ./scripts/worktree.sh --help
      fi
      return 0
      ;;
  esac
  if [ $# -eq 0 ]; then
    echo "usage: ntwork <issue-number-or-name>              launch claude in that worktree" >&2
    echo "       ntwork <issue-number> <first message...>  open/resume THAT issue, rest is the first message" >&2
    echo "       ntwork <a free-text description, no leading number>   auto-number NEW work" >&2
    echo "       ntwork list|sync|finish|drop|path|next-number|next-round [name]   forwarded to ./scripts/worktree.sh" >&2
    echo "       ntwork -h|--help|--usage              show this, with worktree.sh's own reference" >&2
    return 2
  fi
  if [ ! -x ./scripts/worktree.sh ]; then
    echo "no executable ./scripts/worktree.sh in $(pwd) - ntwork only works in a repo that has one" >&2
    return 1
  fi

  # Verbs past 'start' are just forwarded - worktree.sh already owns the real logic, ntwork is
  # only the single name a human needs to remember. None of these launch claude.
  case "$1" in
    list|sync|finish|drop|path|next-number|next-round)
      ./scripts/worktree.sh "$@"
      return $?
      ;;
  esac

  local target query
  if [ $# -eq 1 ] && [[ "$1" != *' '* ]]; then
    # a single space-free token: today's explicit issue-number-or-name path
    target="$1"
  elif [[ "$1" == [0-9]* ]] && [[ "$1" != *' '* ]]; then
    # a bare issue number FOLLOWED by more words - "ntwork 67 fix the login bug" means work ON
    # issue 67 with that as the first message, not a free-text description of new work. Fixed
    # 2026-08-23: this used to fall into the free-text branch below and auto-number a BRAND NEW
    # issue instead, because "more than one word" was checked before "does the first word name
    # an issue". Cost a real collision - typing this to resume issue 67 instead created issue 79.
    target="$1"
    shift
    query="$*"
  else
    # more than one word, not led by a bare number: a free-text description of NEW work
    query="$*"
    target="$(./scripts/worktree.sh next-number 2>/dev/null)"
    if [ -z "$target" ]; then
      echo "this repo's worktree.sh has no 'next-number' subcommand - pass an explicit issue number/name instead" >&2
      return 1
    fi
    echo "-> auto-numbered issue-$target (advisory only - not written anywhere until you commit it)"
  fi

  # Create it if new; harmless (and expected) if it already exists - either way we just want
  # its path next. worktree.sh itself is the one place that knows the name -> branch rule.
  ./scripts/worktree.sh start "$target" >/dev/null 2>&1

  local dest
  dest="$(./scripts/worktree.sh path "$target" 2>/dev/null)"
  if [ -z "$dest" ] || [ ! -d "$dest" ]; then
    echo "could not resolve a worktree for '$target' - try ./scripts/worktree.sh list" >&2
    return 1
  fi

  echo "-> $dest"
  if [ -n "$query" ]; then
    ( cd "$dest" && claude "$query" )
  else
    ( cd "$dest" && claude )
  fi
}
